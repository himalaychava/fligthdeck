# FlightDeck settings. Copy this file to .env and fill in your own values.
# .env is never committed. Each environment (local, dev, prod) has its own.
#
#   [build]   VITE_* values are baked into the app when it is built or started.
#             Restart `npm run dev` (or rebuild) after changing them.
#   [runtime] read by the server while it runs.
#   [secret]  never share in chat or email; get it from the FlightDeck admin.

# ── Data folder ───────────────────────────────────────────────────────────────
# [runtime] Folder that holds ALL FlightDeck data: the workbook, Clarizen/CSP/OCC/
# lifecycle uploads, saved reports, user access and saved edits. Keep it outside
# the code folder. For a fresh, empty folder run: node --env-file=.env scripts/init-data-folder.mjs
DATA_DIR=/path/to/flightdeck-data

# [runtime] Older setting: full path to the workbook. If set, it wins over DATA_DIR
# and the data folder is the folder this file is in. Leave it unset when using DATA_DIR.
# CONTROL_PLANE_DATA_XLSX=/path/to/flightdeck-data/control_plane_demo.xlsx

# [build] Set to "false" to skip the Excel API and use static /data/*.xlsx only.
VITE_USE_EXCEL_KPI_API=true

# ── Access ────────────────────────────────────────────────────────────────────
# [runtime] Comma-separated emails with full admin access (Admin page, all customers).
ADMIN_EMAILS=first.admin@ibm.com,second.admin@ibm.com
# [build] Same list, used by the browser to show admin menus. Keep it equal to ADMIN_EMAILS.
VITE_ADMIN_EMAILS=first.admin@ibm.com,second.admin@ibm.com

# ── IBM SSO (IBM Verify) ──────────────────────────────────────────────────────
# [build + runtime] "true" turns on IBMid sign-in. "false" uses the static email
# login (local development only). The server also reads it: when it is not "true",
# the server trusts the signed-in email the browser sends, so it must be "true"
# on every shared server. Set it to "false" only on your own machine.
VITE_OIDC_ENABLED=true

# [runtime]
IBM_SSO_CLIENT_ID=<client-id-from-ibm-verify>
# [runtime] [secret]
IBM_SSO_CLIENT_SECRET=<client-secret-from-ibm-verify>
IBM_SSO_AUTHORIZATION_URL=https://healthscope.verify.ibm.com/v1.0/endpoint/default/authorize
IBM_SSO_TOKEN_URL=https://healthscope.verify.ibm.com/v1.0/endpoint/default/token
IBM_SSO_USERINFO_URL=https://healthscope.verify.ibm.com/v1.0/endpoint/default/userinfo
# [runtime] Must match exactly what is registered in IBM Verify → Redirect URIs.
IBM_SSO_REDIRECT_URI=https://<server-host>:8080/auth/callback

# [runtime] [secret] Long random string that signs session cookies. Different per environment.
SESSION_SECRET=change-me-to-a-long-random-string

# ── IBM Solution Builder API (Insights → Offerings) ──────────────────────────
# [runtime]
SOLUTION_BUILDER_API_BASE_URL=https://solconfig-backend-prod.expert-labs-solution-tool.dal.app.cirrus.ibm.com
# [runtime] [secret]
SOLUTION_BUILDER_API_KEY=<x-api-key-value>
# [runtime] "View details" link for one offering. Must contain the literal "{offeringId}".
SOLUTION_BUILDER_UI_OFFERING_URL_TEMPLATE=https://w3.ibm.com/services/solution-builder/offering/{offeringId}

# ── Bob (AI insights) ─────────────────────────────────────────────────────────
# [runtime] [secret] Key for the `bob` CLI, which must be installed and on the PATH.
# Without it, Run Reports still works with "skip AI".
BOBSHELL_API_KEY=<bob-api-key>

# ── Run Reports ───────────────────────────────────────────────────────────────
# [runtime] Optional. Where saved reports are stored: "local" (default, the data folder).
# REPORT_STORAGE_BACKEND=local
# [runtime] Optional. How many customers a Run Reports batch processes at once.
# REPORT_BATCH_CONCURRENCY=2

# ── Health Check Tool ─────────────────────────────────────────────────────────
# [runtime] Folder shared with the Health Check Tool. Its requests/ and completed/
# subfolders are used automatically.
HEALTH_CHECK_SHARED_DIR=/path/to/health-check-shared
# [build] Address of the Health Check Tool.
VITE_HEALTH_CHECK_TOOL_URL=https://<health-check-host>:5001
# [build] Box link to the Health Check user guide.
VITE_HEALTH_CHECK_GUIDE_URL=<box-link-to-health-check-user-guide>

# ── Header "Support & feedback" menu ──────────────────────────────────────────
# [build] Box link to the FlightDeck user guide.
VITE_APP_USER_GUIDE_URL=<box-link-to-flightdeck-user-guide>

# ── HTTPS for the Vite server (Fyre servers only) ─────────────────────────────
# [runtime] Optional. When both files exist the server serves HTTPS on port 8080.
# SSL_KEY_PATH=/path/to/server.key
# SSL_CERT_PATH=/path/to/server.crt
