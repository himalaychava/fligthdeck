# ── KPI / Demo Data ────────────────────────────────────────────────────────────
# Path to the main Excel workbook (must be writable by the server process).
CONTROL_PLANE_DATA_XLSX=/root/control-plane/public/data/control_plane_demo.xlsx

# Set to "false" to skip Excel API and use static /data/*.xlsx only.
VITE_USE_EXCEL_KPI_API=true

# ── Health Check Tool ──────────────────────────────────────────────────────────
# !! BAKED IN AT BUILD TIME !! — run `npm run build` after changing
VITE_HEALTH_CHECK_TOOL_URL=https://c53097v1.fyre.ibm.com:5001
# Box link for the Health Check user guide doc
VITE_HEALTH_CHECK_GUIDE_URL=https://ibm.box.com/s/lfnd8kflf73bpfp80vbb925htq9cchhy

# ── Header "Support & feedback" menu ────────────────────────────────────────────
# !! BAKED IN AT BUILD TIME !! — run `npm run build` after changing
# Box link for the Control Plane app user guide doc
VITE_APP_USER_GUIDE_URL=<box-link-to-control-plane-user-guide>

# Shared directory for HC Tool Excel files (SERVER RUNTIME — no rebuild needed)
# /requests and /completed subdirs are derived automatically
HEALTH_CHECK_SHARED_DIR=/root/health-check-shared

# ── IBM SSO (IBM Verify) ───────────────────────────────────────────────────────
# Toggle SSO on/off — !! BAKED IN AT BUILD TIME !! — run `npm run build` after changing
# Set to "false" to use static email login (local dev)
VITE_OIDC_ENABLED=true

# All IBM_SSO_* vars below are SERVER RUNTIME — no rebuild needed after changing
IBM_SSO_CLIENT_ID=<your-client-id-from-ibm-verify>
IBM_SSO_CLIENT_SECRET=<your-client-secret-from-ibm-verify>
IBM_SSO_AUTHORIZATION_URL=https://healthscope.verify.ibm.com/v1.0/endpoint/default/authorize
IBM_SSO_TOKEN_URL=https://healthscope.verify.ibm.com/v1.0/endpoint/default/token
IBM_SSO_USERINFO_URL=https://healthscope.verify.ibm.com/v1.0/endpoint/default/userinfo
# Must match exactly what is registered in IBM Verify → Redirect URIs
IBM_SSO_REDIRECT_URI=https://c53097v1.fyre.ibm.com:8080/auth/callback

# Random string to sign session cookies — change to something secret
SESSION_SECRET=change-me-to-a-long-random-string

# ── IBM Solution Builder API (Expert Labs) ─────────────────────────────────────
# Used by the Insights page "Offerings" section — SERVER RUNTIME, no rebuild needed
SOLUTION_BUILDER_API_BASE_URL=https://solconfig-backend-prod.expert-labs-solution-tool.dal.app.cirrus.ibm.com
SOLUTION_BUILDER_API_KEY=<x-api-key value>
# Per-offering "view details" route on the Solution Builder web UI. Must contain
# the literal placeholder "{offeringId}".
SOLUTION_BUILDER_UI_OFFERING_URL_TEMPLATE=https://w3.ibm.com/services/solution-builder/offering/{offeringId}
